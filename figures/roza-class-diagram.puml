@startuml roza-class-diagram
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam class {
	BackgroundColor #f6f7f9
	BorderColor #7f8c99
	FontColor #202833
}
skinparam interface {
	BackgroundColor #f6f7f9
	BorderColor #7f8c99
	FontColor #202833
}
skinparam package {
	BorderColor #7f8c99
	FontColor #202833
}
skinparam arrow {
	Color #65717d
}

package loading {
	interface CodeFileLoader {
		+ load(): LoadedCodeFiles
	}
	class LoadedCodeFiles {
		- codeFiles: List<CodeFile>
		+ codeFiles(): List<CodeFile>
	}
	class CodeFile {
		- source: String
		- content: String
	}
}

package parsing {
	interface TestClassParser {
		+ parse(codeFiles: LoadedCodeFiles): ParsedTestClasses
	}
	class ParsedTestClasses {
		- testClasses: List<TestClass>
		- violations: List<TestCodeViolation>
		+ testClasses(): List<TestClass>
		+ violations(): List<TestCodeViolation>
	}
	class TestClass {
		- name: String
		- fields: List<Field>
		- testMethods: List<TestMethod>
	}
	class TestCodeViolation {
		- scope: ViolationScope
		- testClassName: String
		- description: String
	}
}

package decomposition {
	interface TestCaseDecomposer {
		+ decompose(parsedTestClasses: ParsedTestClasses): DecomposedTestCases
	}
	class DecomposedTestCases {
		- testCases: List<TestCase>
		+ testCases(): List<TestCase>
	}
	class TestCase {
		- name: String
		- body: CodeBlock
		- sourceTestClass: TestClass
	}
}

package measurement {
	interface TestCaseSimilarityMeasurer {
		+ measure(testCases: DecomposedTestCases): TestCaseSimilarityMatrix
	}
	class TestCaseSimilarityMatrix {
		- testCases: List<TestCase>
		- similarities: double[]
		+ size(): int
		+ testCaseAt(index: int): TestCase
		+ similarity(sourceIndex: int, targetIndex: int): double
	}
}

CodeFileLoader ..> LoadedCodeFiles
LoadedCodeFiles *-- CodeFile

TestClassParser ..> LoadedCodeFiles
TestClassParser ..> ParsedTestClasses
ParsedTestClasses *-- TestClass
ParsedTestClasses *-- TestCodeViolation

TestCaseDecomposer ..> ParsedTestClasses
TestCaseDecomposer ..> DecomposedTestCases
DecomposedTestCases *-- TestCase

TestCaseSimilarityMeasurer ..> DecomposedTestCases
TestCaseSimilarityMeasurer ..> TestCaseSimilarityMatrix
TestCaseSimilarityMatrix ..> TestCase
@enduml
