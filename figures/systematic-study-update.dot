digraph SystematicStudyUpdate {
  graph [
    bgcolor="white",
    rankdir=TB,
    splines=ortho,
    nodesep="0.40",
    ranksep="0.35",
    margin="0.02",
    pad="0.05",
    charset="UTF-8"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Arial",
    fontsize=20,
    color="#55606a",
    penwidth=1.6,
    fillcolor="#f8f9fa",
    margin="0.16,0.10"
  ];

  edge [
    color="#55606a",
    arrowsize=0.7,
    penwidth=1.4,
    fontname="Arial",
    fontsize=16
  ];

  identified [
    fillcolor="#e8edf1",
    label=<
      <B>Publicações encontradas na busca</B><BR/>
      <B>em bases de dados</B><BR/>
      376 publicações
    >
  ];

  screening1 [
    label=<
      <B>Etapa 1: triagem de título e resumo</B><BR/>
      A publicação aborda refatoração ou reuso<BR/>
      de casos de teste?
    >
  ];

  selected1 [
    fillcolor="#eef8f1",
    label=<
      <B>Selecionadas para</B><BR/>
      <B>leitura completa</B><BR/>
      20 publicações
    >
  ];

  unclear [
    fillcolor="#fff7df",
    label=<
      <B>Publicações incertas</B><BR/>
      31 publicações
    >
  ];

  excluded1 [
    fillcolor="#fdecec",
    color="#c85c5c",
    label=<
      <B>Excluídas após</B><BR/>
      <B>título e resumo</B><BR/>
      325 publicações
    >
  ];

  screening2 [
    label=<
      <B>Etapa 2: triagem de</B><BR/>
      <B>introdução e conclusão</B><BR/>
      Reavaliação das publicações incertas
    >
  ];

  selected2 [
    fillcolor="#eef8f1",
    label=<
      <B>Selecionadas para</B><BR/>
      <B>leitura completa</B><BR/>
      0 publicações
    >
  ];

  excluded2 [
    fillcolor="#fdecec",
    color="#c85c5c",
    label=<
      <B>Excluídas após a</B><BR/>
      <B>segunda triagem</B><BR/>
      31 publicações
    >
  ];

  full_reading [
    label=<
      <B>Etapa 3: leitura completa</B><BR/>
      20 publicações
    >
  ];

  relevant [
    fillcolor="#eef8f1",
    label=<
      <B>Publicações relevantes</B><BR/>
      7 publicações
    >
  ];

  excluded3 [
    fillcolor="#fdecec",
    color="#c85c5c",
    label=<
      <B>Excluídas após a</B><BR/>
      <B>leitura completa</B><BR/>
      13 publicações
    >
  ];

  duplicates [
    fillcolor="#fff7df",
    label=<
      <B>Publicação duplicada</B><BR/>
      <B>removida</B><BR/>
      1 publicação duplicada
    >
  ];

  included [
    fillcolor="#dff2df",
    color="#4d8b4d",
    penwidth=2.2,
    label=<
      <B>Publicações incluídas</B><BR/>
      6 publicações
    >
  ];

  identified -> screening1;
  screening1:s -> selected1:n;
  screening1:s -> unclear:n;
  screening1:s -> excluded1:n;
  unclear -> screening2;
  screening2 -> selected2;
  screening2 -> excluded2;
  selected1 -> full_reading;
  selected2 -> full_reading;
  full_reading -> relevant;
  full_reading -> excluded3;
  relevant -> duplicates;
  duplicates -> included;

  { rank=same; selected1; unclear; excluded1; }
  { rank=same; selected2; excluded2; }
  { rank=same; relevant; excluded3; }
}
