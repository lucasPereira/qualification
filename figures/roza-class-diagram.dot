digraph RozaClassDiagram {
	graph [
		bgcolor="white",
		center=true,
		clusterrank=local,
		fontname="Helvetica",
		margin=0,
		newrank=true,
		nodesep=0.62,
		pad=0.06,
		rankdir=LR,
		ranksep=0.45,
		splines=line
	];

	node [
		color="#7f8c99",
		fillcolor="#f6f7f9",
		fontname="Helvetica",
		fontsize=20,
		margin="0.06,0.05",
		shape=plain,
		style=filled
	];

	edge [
		arrowhead=vee,
		arrowsize=0.75,
		color="#65717d",
		fontname="Helvetica",
		fontsize=15,
		penwidth=1.25
	];

	subgraph cluster_loading {
		color="#7f8c99";
		fontname="Helvetica";
		fontsize=22;
		label="loading";
		labeljust="c";
		labelloc="t";
		margin=12;
		style="rounded";

		CodeFileLoader [
			label=<
				<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#7f8c99">
					<TR><TD PORT="n" CELLPADDING="5"><I>«interface»</I><BR/><B>CodeFileLoader</B></TD></TR>
					<TR><TD PORT="s" ALIGN="LEFT" BORDER="1" SIDES="T" CELLPADDING="5">
						<FONT FACE="Courier" POINT-SIZE="16">+ load():</FONT><BR ALIGN="LEFT"/>
						<FONT FACE="Courier" POINT-SIZE="16">  LoadedCodeFiles</FONT>
					</TD></TR>
				</TABLE>
			>
		];
		LoadedCodeFiles [
			label=<
				<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#7f8c99">
					<TR><TD PORT="n" CELLPADDING="5"><B>LoadedCodeFiles</B></TD></TR>
					<TR><TD ALIGN="LEFT" BORDER="1" SIDES="T" CELLPADDING="5"><FONT FACE="Courier" POINT-SIZE="16">- codeFiles: List&lt;CodeFile&gt;</FONT></TD></TR>
					<TR><TD PORT="s" ALIGN="LEFT" BORDER="1" SIDES="T" CELLPADDING="5"><FONT FACE="Courier" POINT-SIZE="16">+ codeFiles(): List&lt;CodeFile&gt;</FONT></TD></TR>
				</TABLE>
			>
		];
		CodeFile [
			label=<
				<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#7f8c99">
					<TR><TD PORT="n" CELLPADDING="5"><B>CodeFile</B></TD></TR>
					<TR><TD PORT="s" ALIGN="LEFT" BORDER="1" SIDES="T" CELLPADDING="5">
						<FONT FACE="Courier" POINT-SIZE="16">- source: String</FONT><BR ALIGN="LEFT"/>
						<FONT FACE="Courier" POINT-SIZE="16">- content: String</FONT>
					</TD></TR>
				</TABLE>
			>
		];
		{ rank=same; CodeFileLoader; LoadedCodeFiles; CodeFile; }
		CodeFile -> LoadedCodeFiles [style=invis, weight=80];
		LoadedCodeFiles -> CodeFileLoader [style=invis, weight=80];
	}

	subgraph cluster_parsing {
		color="#7f8c99";
		fontname="Helvetica";
		fontsize=22;
		label="parsing";
		labeljust="c";
		labelloc="t";
		margin=12;
		style="rounded";

		TestClassParser [
			label=<
				<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#7f8c99">
					<TR><TD PORT="n" CELLPADDING="5"><I>«interface»</I><BR/><B>TestClassParser</B></TD></TR>
					<TR><TD PORT="s" ALIGN="LEFT" BORDER="1" SIDES="T" CELLPADDING="5">
						<FONT FACE="Courier" POINT-SIZE="16">+ parse(LoadedCodeFiles):</FONT><BR ALIGN="LEFT"/>
						<FONT FACE="Courier" POINT-SIZE="16">  ParsedTestClasses</FONT>
					</TD></TR>
				</TABLE>
			>
		];
		ParsedTestClasses [
			label=<
				<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#7f8c99">
					<TR><TD PORT="n" CELLPADDING="5"><B>ParsedTestClasses</B></TD></TR>
					<TR><TD ALIGN="LEFT" BORDER="1" SIDES="T" CELLPADDING="5"><FONT FACE="Courier" POINT-SIZE="16">- testClasses: List&lt;TestClass&gt;</FONT></TD></TR>
					<TR><TD PORT="s" ALIGN="LEFT" BORDER="1" SIDES="T" CELLPADDING="5"><FONT FACE="Courier" POINT-SIZE="16">+ testClasses(): List&lt;TestClass&gt;</FONT></TD></TR>
				</TABLE>
			>
		];
		TestClass [
			label=<
				<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#7f8c99">
					<TR><TD PORT="n" CELLPADDING="5"><B>TestClass</B></TD></TR>
					<TR><TD ALIGN="LEFT" BORDER="1" SIDES="T" CELLPADDING="5">
						<TABLE ALIGN="LEFT" BORDER="0" CELLBORDER="0" CELLSPACING="0">
							<TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="16">- name: String</FONT></TD></TR>
							<TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="16">- packageName: String</FONT></TD></TR>
							<TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="16">- imports: List&lt;String&gt;</FONT></TD></TR>
							<TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="16">- fields: List&lt;Field&gt;</FONT></TD></TR>
							<TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="16">- setupMethods: List&lt;SetupMethod&gt;</FONT></TD></TR>
							<TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="16">- helperMethods: List&lt;HelperMethod&gt;</FONT></TD></TR>
							<TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="16">- testMethods: List&lt;TestMethod&gt;</FONT></TD></TR>
						</TABLE>
					</TD></TR>
				</TABLE>
			>
		];
		{ rank=same; TestClassParser; ParsedTestClasses; TestClass; }
		TestClass -> ParsedTestClasses [style=invis, weight=80];
		ParsedTestClasses -> TestClassParser [style=invis, weight=80];
	}

	subgraph cluster_decomposition {
		color="#7f8c99";
		fontname="Helvetica";
		fontsize=22;
		label="decomposition";
		labeljust="c";
		labelloc="t";
		margin=12;
		style="rounded";

		TestCaseDecomposer [
			label=<
				<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#7f8c99">
					<TR><TD PORT="n" CELLPADDING="5"><I>«interface»</I><BR/><B>TestCaseDecomposer</B></TD></TR>
					<TR><TD PORT="s" ALIGN="LEFT" BORDER="1" SIDES="T" CELLPADDING="5">
						<FONT FACE="Courier" POINT-SIZE="16">+ decompose(ParsedTestClasses):</FONT><BR ALIGN="LEFT"/>
						<FONT FACE="Courier" POINT-SIZE="16">  DecomposedTestCases</FONT>
					</TD></TR>
				</TABLE>
			>
		];
		DecomposedTestCases [
			label=<
				<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#7f8c99">
					<TR><TD PORT="n" CELLPADDING="5"><B>DecomposedTestCases</B></TD></TR>
					<TR><TD ALIGN="LEFT" BORDER="1" SIDES="T" CELLPADDING="5"><FONT FACE="Courier" POINT-SIZE="16">- testCases: List&lt;TestCase&gt;</FONT></TD></TR>
					<TR><TD PORT="s" ALIGN="LEFT" BORDER="1" SIDES="T" CELLPADDING="5"><FONT FACE="Courier" POINT-SIZE="16">+ testCases(): List&lt;TestCase&gt;</FONT></TD></TR>
				</TABLE>
			>
		];
		TestCase [
			label=<
				<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#7f8c99">
					<TR><TD PORT="n" CELLPADDING="5"><B>TestCase</B></TD></TR>
					<TR><TD PORT="s" ALIGN="LEFT" BORDER="1" SIDES="T" CELLPADDING="5">
						<FONT FACE="Courier" POINT-SIZE="16">- name: String</FONT><BR ALIGN="LEFT"/>
						<FONT FACE="Courier" POINT-SIZE="16">- body: CodeBlock</FONT><BR ALIGN="LEFT"/>
						<FONT FACE="Courier" POINT-SIZE="16">- sourceTestClass: TestClass</FONT>
					</TD></TR>
				</TABLE>
			>
		];
		{ rank=same; TestCaseDecomposer; DecomposedTestCases; TestCase; }
		TestCase -> DecomposedTestCases [style=invis, weight=80];
		DecomposedTestCases -> TestCaseDecomposer [style=invis, weight=80];
	}

	subgraph cluster_measurement {
		color="#7f8c99";
		fontname="Helvetica";
		fontsize=22;
		label="measurement";
		labeljust="c";
		labelloc="t";
		margin=12;
		style="rounded";

		TestCaseSimilarityMeasurer [
			label=<
				<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#7f8c99">
					<TR><TD PORT="n" CELLPADDING="5"><I>«interface»</I><BR/><B>TestCaseSimilarityMeasurer</B></TD></TR>
					<TR><TD PORT="s" ALIGN="LEFT" BORDER="1" SIDES="T" CELLPADDING="5">
						<FONT FACE="Courier" POINT-SIZE="16">+ measure(DecomposedTestCases):</FONT><BR ALIGN="LEFT"/>
						<FONT FACE="Courier" POINT-SIZE="16">  TestCaseSimilarityMatrix</FONT>
					</TD></TR>
				</TABLE>
			>
		];
		TestCaseSimilarityMatrix [
			label=<
				<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#7f8c99">
					<TR><TD PORT="n" CELLPADDING="5"><B>TestCaseSimilarityMatrix</B></TD></TR>
					<TR><TD ALIGN="LEFT" BORDER="1" SIDES="T" CELLPADDING="5"><FONT FACE="Courier" POINT-SIZE="16">- testCases: List&lt;TestCase&gt;</FONT></TD></TR>
					<TR><TD ALIGN="LEFT" BORDER="1" SIDES="T" CELLPADDING="5">
						<TABLE ALIGN="LEFT" BORDER="0" CELLBORDER="0" CELLSPACING="0">
							<TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="16">+ similarity(i, j): double</FONT></TD></TR>
							<TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="16">+ size(): int</FONT></TD></TR>
							<TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="16">+ testCaseAt(i): TestCase</FONT></TD></TR>
						</TABLE>
					</TD></TR>
				</TABLE>
			>
		];
		{ rank=same; TestCaseSimilarityMeasurer; TestCaseSimilarityMatrix; }
		TestCaseSimilarityMatrix -> TestCaseSimilarityMeasurer [style=invis, weight=80];
	}

	CodeFileLoader -> TestClassParser [style=invis, weight=40];
	TestClassParser -> TestCaseDecomposer [style=invis, weight=40];
	TestCaseDecomposer -> TestCaseSimilarityMeasurer [style=invis, weight=40];

	CodeFileLoader:s -> LoadedCodeFiles:n [constraint=false, style=dashed];
	LoadedCodeFiles:s -> CodeFile:n [
		arrowhead=none,
		arrowtail=diamond,
		constraint=false,
		dir=both,
		headlabel="  0..*"
	];

	TestClassParser -> LoadedCodeFiles [constraint=false, style=dashed];
	TestClassParser:s -> ParsedTestClasses:n [constraint=false, style=dashed];
	ParsedTestClasses:s -> TestClass:n [
		arrowhead=none,
		arrowtail=diamond,
		constraint=false,
		dir=both,
		headlabel="  0..*"
	];

	TestCaseDecomposer -> ParsedTestClasses [constraint=false, style=dashed];
	TestCaseDecomposer:s -> DecomposedTestCases:n [constraint=false, style=dashed];
	DecomposedTestCases:s -> TestCase:n [
		arrowhead=none,
		arrowtail=diamond,
		constraint=false,
		dir=both,
		headlabel="  0..*"
	];

	TestCaseSimilarityMeasurer -> DecomposedTestCases [constraint=false, style=dashed];
	TestCaseSimilarityMeasurer:s -> TestCaseSimilarityMatrix:n [constraint=false, style=dashed];
	TestCaseSimilarityMatrix -> TestCase [constraint=false, style=dashed];
}
